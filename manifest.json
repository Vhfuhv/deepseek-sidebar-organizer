{
  "manifest_version": 3,
  "name": "DeepSeek Sidebar Organizer",
  "version": "1.0.0",
  "description": "Organizes DeepSeek chats and improves sidebar navigation.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://chat.deepseek.com/*"],
    "js": ["settings.js", "groups.js", "content.js"],
    "css": ["content.css", "content-groups.css"],
    "run_at": "document_idle"
  }]
}
